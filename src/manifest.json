{
  "manifest_version": 3,
  "name": "Workspace Dark",
  "version": "0.1.0",
  "description": "Code-editor themes (Base16/Base24) for Google Docs, Sheets, Slides, Forms and Drive — UI and document, separately. Local only.",
  "browser_specific_settings": {
    "gecko": {
      "id": "workspace-dark@local",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "action": {
    "default_title": "Workspace Dark — open theme panel",
    "default_icon": "icon.svg"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": ["unlimitedStorage"],
  "host_permissions": [
    "https://docs.google.com/*",
    "https://drive.google.com/*",
    "https://*.gstatic.com/*",
    "https://*.googleusercontent.com/*",
    "https://lh3.google.com/*",
    "https://github.com/*",
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/*", "https://drive.google.com/*"],
      "js": ["hook.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["https://docs.google.com/*", "https://drive.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "commands": {
    "toggle-theme": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Turn themes on/off for this page"
    },
    "open-panel": {
      "suggested_key": { "default": "Alt+Shift+T" },
      "description": "Open the theme panel"
    }
  }
}
